<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Company>Parallel Systems</Company>
    <Product>ParallelSystemsPlugin</Product>
    <Copyright>Copyright © Parallel Systems</Copyright>

    <!--
      Plugin release numbering follows the existing 1.x changelog.
      1     = product generation
      17    = feature iteration
      9     = package-specific Excel worksheet revision
    -->
    <Version>1.17.9</Version>
    <AssemblyVersion>1.17.9.0</AssemblyVersion>
    <FileVersion>1.17.9.0</FileVersion>
    <InformationalVersion>1.17.9</InformationalVersion>

    <!-- Prevent the SDK from displaying +<git SHA> in About & Manual. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
