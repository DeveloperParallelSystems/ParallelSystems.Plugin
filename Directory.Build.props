<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Company>Parallel Systems</Company>
    <Product>ParallelSystemsPlugin</Product>
    <Copyright>Copyright © Parallel Systems</Copyright>

    <!--
      Plugin release numbering follows the existing 1.x changelog.
      1     = product generation
      18    = feature iteration
      1     = patch revision
    -->
    <Version>1.18.1</Version>
    <AssemblyVersion>1.18.1</AssemblyVersion>
    <FileVersion>1.18.1</FileVersion>
    <InformationalVersion>1.18.1</InformationalVersion>

    <!-- Prevent the SDK from displaying +<git SHA> in About & Manual. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
