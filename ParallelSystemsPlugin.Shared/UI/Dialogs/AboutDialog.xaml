<Window x:Class="ParallelSystemPlugin.UI.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parallel Systems — About &amp; Manual" SizeToContent="WidthAndHeight"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        MinWidth="720" MinHeight="460" MaxWidth="980" MaxHeight="820"
        FontFamily="Segoe UI Variable, Segoe UI, Segoe UI Historic, Arial, Helvetica, sans-serif"
        FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
        ShowInTaskbar="False" Topmost="False">

    <Window.Resources>
        <!-- Accent for header icon -->
        <SolidColorBrush x:Key="InfoBrush" Color="#2563EB"/>

        <!-- Blue (accent) button with extra padding -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border Background="{TemplateBinding Background}" CornerRadius="12"
                                    Padding="{TemplateBinding Padding}"/>
                            <Border x:Name="Hover" CornerRadius="12" Background="White" Opacity="0"/>
                            <Border x:Name="Press" CornerRadius="12" Background="Black" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.12" Duration="0:0:0.10"/>
                                            <DoubleAnimation Storyboard.TargetName="Root"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                To="1.02" Duration="0:0:0.10"/>
                                            <DoubleAnimation Storyboard.TargetName="Root"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                To="1.02" Duration="0:0:0.10"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="Root"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                To="1" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="Root"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Press"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.16" Duration="0:0:0.05"/>
                                            <DoubleAnimation Storyboard.TargetName="Root"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                To="0.985" Duration="0:0:0.05"/>
                                            <DoubleAnimation Storyboard.TargetName="Root"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                To="0.985" Duration="0:0:0.05"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Press"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.10"/>
                                            <DoubleAnimation Storyboard.TargetName="Root"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                To="1" Duration="0:0:0.10"/>
                                            <DoubleAnimation Storyboard.TargetName="Root"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                To="1" Duration="0:0:0.10"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <!-- Header -->
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,12">
            <Path Width="22" Height="22" Fill="{StaticResource InfoBrush}" Margin="0,0,8,0"
                  Data="M12,2 A10,10 0 1 1 12,22 M12,6 L12,14 M12,16 L12,18"/>
            <TextBlock Text="Parallel Systems — User Manual &amp; About"
                       FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Tabs -->
        <TabControl>
            <!-- USER MANUAL -->
            <TabItem Header="User Manual">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Modern doc viewer -->
                    <FlowDocumentScrollViewer x:Name="ManualViewer"
                                              Grid.Row="0"
                                              IsToolBarVisible="False"
                                              VerticalScrollBarVisibility="Auto" />

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Style="{StaticResource AccentButton}" Content="Open Full Manual"
                                Click="OnOpenManual"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- CHANGELOG -->
            <TabItem Header="What’s New">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <FlowDocumentScrollViewer x:Name="ChangelogViewer"
                                              Grid.Row="0"
                                              IsToolBarVisible="False"
                                              VerticalScrollBarVisibility="Auto" />

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Style="{StaticResource AccentButton}" Content="Open Change Log"
                                Click="OnOpenChangelog"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ABOUT -->
            <TabItem Header="About">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Version: " FontWeight="SemiBold"/>
                        <TextBlock x:Name="VersionLabel" Text="0.0.0"/>
                        <TextBlock Text="  •  Release: " FontWeight="SemiBold" Margin="8,0,0,0"/>
                        <TextBlock Text="Internal / Unreleased"/>
                        <TextBlock Text="  •  Build Date: " FontWeight="SemiBold" Margin="8,0,0,0"/>
                        <TextBlock x:Name="BuildDateLabel" Text="—"/>
                    </WrapPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="880">
                            <TextBlock Text="About Parallel Systems" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,6"/>

                            <TextBlock TextWrapping="Wrap">
                                Parallel Systems develops model-driven fabrication and project-delivery tools that improve consistency, traceability, quality assurance, and coordination from Revit modelling through fabrication and handover.
                            </TextBlock>

                            <TextBlock Text="Parallel Systems Revit Plugin" FontWeight="SemiBold" Margin="0,14,0,4"/>
                            <TextBlock TextWrapping="Wrap">
                                This internal build combines property mapping, procurement reporting, fabrication STEP preparation, QA tools, configurable project standards, and silent timesheet monitoring in one Revit add-in.
                            </TextBlock>

                            <TextBlock Text="Monitoring flow" FontWeight="SemiBold" Margin="0,14,0,4"/>
                            <StackPanel Margin="12,0,0,8">
                                <TextBlock TextWrapping="Wrap" Text="• Revit automatically captures compact project and work-session evidence; drafters do not complete a timesheet form."/>
                                <TextBlock TextWrapping="Wrap" Text="• Checkpoints are sent through HTTPS to the Parallel Systems API and stored in PostgreSQL."/>
                                <TextBlock TextWrapping="Wrap" Text="• Task categories are determined by reusable web rules or administrator review."/>
                                <TextBlock TextWrapping="Wrap" Text="• Client assignment is always a separate manual administrator action."/>
                                <TextBlock TextWrapping="Wrap" Text="• Temporary connection failures are protected by a local file outbox after authorization has completed."/>
                            </StackPanel>

                            <TextBlock Text="Data minimization" FontWeight="SemiBold" Margin="0,10,0,4"/>
                            <TextBlock TextWrapping="Wrap">
                                The tracker stores summarized session evidence and duration totals. It does not upload individual element IDs, screenshots, keystrokes, or the contents of unrelated applications.
                            </TextBlock>

                            <TextBlock Margin="0,14,0,8">
                                <Run Text="Website: "/>
                                <Hyperlink NavigateUri="https://www.parallelsystems.com.au/" RequestNavigate="OnLink">parallelsystems.com.au</Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Style="{StaticResource AccentButton}" Content="Visit Website" Click="OnVisitSite"/>
                        <Button Style="{StaticResource AccentButton}" Content="Developer Notes" Margin="8,0,0,0"
                                Click="OnOpenDevelopers"/>
                        <Button Style="{StaticResource AccentButton}" Content="Close" Margin="8,0,0,0"
                                IsDefault="True" Click="OnClose"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
