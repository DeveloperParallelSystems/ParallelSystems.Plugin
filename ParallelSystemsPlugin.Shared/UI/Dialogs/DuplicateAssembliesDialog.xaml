<Window x:Class="ParallelSystemPlugin.UI.DuplicateAssembliesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Duplicate Assemblies"
        Width="1280"
        Height="720"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="Manual"
        ResizeMode="CanResizeWithGrip"
        Background="#F5F6F8"
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Stretch">
    <!-- Changed by Jhay: stretch and paint the complete host client area; only the preview row grows. -->
    <Grid x:Name="PART_Root"
          Margin="0"
          Background="#F5F6F8"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="18,18,18,0"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Text="Batch Assembly Duplication Preview" />

        <Grid Grid.Row="1" Margin="18,16,18,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Starting number" />
            <TextBox x:Name="PART_StartingNumber"
                     Grid.Column="1"
                     Margin="10,0,0,0"
                     Padding="6,4"
                     Text="0"
                     TextChanged="OnInputChanged" />
            <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="Destination level" />
            <ComboBox x:Name="PART_DestinationLevel"
                      Grid.Column="4"
                      Margin="10,0,0,0"
                      Padding="6,4"
                      DisplayMemberPath="DisplayName"
                      SelectionChanged="OnInputChanged" />
        </Grid>

        <Border Grid.Row="2"
                Margin="18,0"
                MinHeight="180"
                Background="White"
                BorderBrush="#CDD2D9"
                BorderThickness="1"
                CornerRadius="3"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <DataGrid x:Name="PART_Preview"
                      AutoGenerateColumns="False"
                      IsReadOnly="False"
                      CanUserAddRows="False"
                      MinColumnWidth="40"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      SelectionMode="Single"
                      CellEditEnding="OnPreviewCellEditEnding"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
                <DataGrid.Columns>
                    <!-- Changed by Jhay: weighted columns remain visible initially and respond proportionally to resizing. -->
                    <DataGridTextColumn Header="Order" Binding="{Binding Order}" Width="60" IsReadOnly="True" />
                    <DataGridTextColumn Header="Source" Binding="{Binding SourceName}" Width="3*" IsReadOnly="True" />
                    <DataGridTextColumn Header="Source Level" Binding="{Binding SourceLevel}" Width="1.25*" IsReadOnly="True" />
                    <DataGridTextColumn Header="Target" Binding="{Binding TargetName}" Width="3*" IsReadOnly="True" />
                    <DataGridTextColumn x:Name="PART_AssignedNumberColumn"
                                        Header="Assigned Number"
                                        Binding="{Binding AssignedNumber, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                        Width="1.25*" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="2*" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="3"
                   Margin="18,12,18,0"
                   TextWrapping="Wrap"
                   Foreground="#3F4650"
                   Text="Numbering follows original source order. Only complete target-name conflicts are skipped. Editing an Assigned Number creates a manual anchor for that row and all rows below it." />

        <Border x:Name="PART_IssuePanel"
                Grid.Row="4"
                Margin="18,10,18,12"
                Padding="10"
                Background="#FFF4E5"
                CornerRadius="3">
            <!-- Changed by Jhay: errors remain compact until the user explicitly views the report. -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PART_Issues"
                               Grid.Column="0"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="#7A3E00"
                               Text="Calculating preview." />
                    <Button x:Name="PART_ViewErrors"
                            Grid.Column="1"
                            MinWidth="100"
                            Padding="10,4"
                            Content="View Errors"
                            Visibility="Collapsed"
                            Click="OnViewErrorsClick" />
                </Grid>

                <Border x:Name="PART_ErrorDetails"
                        Grid.Row="1"
                        Margin="0,10,0,0"
                        Padding="8"
                        Background="White"
                        BorderBrush="#E5B96A"
                        BorderThickness="1"
                        CornerRadius="2"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox x:Name="PART_ErrorText"
                                 Grid.Row="0"
                                 MinHeight="100"
                                 MaxHeight="180"
                                 Padding="6"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 Background="#FFFDF8"
                                 BorderThickness="0" />
                        <Button x:Name="PART_CopyErrors"
                                Grid.Row="1"
                                Margin="0,8,0,0"
                                Padding="10,4"
                                HorizontalAlignment="Right"
                                Content="Copy All Errors"
                                Click="OnCopyErrorsClick" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <StackPanel Grid.Row="5"
                    Margin="18,0,18,18"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="100" Margin="0,0,10,0" Padding="8,5" Content="Cancel" IsCancel="True" Click="OnCancelClick" />
            <Button x:Name="PART_Confirm"
                    Width="120"
                    Padding="8,5"
                    Content="Confirm"
                    IsDefault="True"
                    IsEnabled="False"
                    Click="OnConfirmClick" />
        </StackPanel>
    </Grid>
</Window>
