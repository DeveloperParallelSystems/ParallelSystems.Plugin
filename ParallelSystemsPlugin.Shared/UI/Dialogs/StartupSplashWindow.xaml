<Window x:Class="ParallelSystemPlugin.UI.StartupSplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parallel Systems Revit Plugin"
        Width="920"
        Height="620"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI, Arial, sans-serif">

    <Border CornerRadius="8"
            BorderBrush="#D4D4D4"
            BorderThickness="1"
            Background="#FFFDF9"
            Effect="{DynamicResource SplashShadow}">

        <Border.Resources>
            <DropShadowEffect x:Key="SplashShadow"
                              BlurRadius="20"
                              ShadowDepth="4"
                              Opacity="0.35"/>

            <SolidColorBrush x:Key="Orange"
                             Color="#F58220"/>

            <SolidColorBrush x:Key="Green"
                             Color="#8CC87B"/>

            <SolidColorBrush x:Key="DarkGreen"
                             Color="#5D9450"/>

            <SolidColorBrush x:Key="LightGreen"
                             Color="#F1F8EF"/>

            <SolidColorBrush x:Key="Dark"
                             Color="#151515"/>

            <SolidColorBrush x:Key="Muted"
                             Color="#666666"/>
        </Border.Resources>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="270"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="46"/>
            </Grid.RowDefinitions>

            <!-- ========================================================= -->
            <!-- Hero section                                              -->
            <!-- ========================================================= -->
            <Grid Grid.Row="0"
                  ClipToBounds="True"
                  Background="#F7F9FA">

                <!-- Parallel Systems website logo -->
                <Image Source="/UI/Assets/ParallelSystemsWebsiteLogo.png"
                       Stretch="UniformToFill"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Center"
                       Opacity="0.92"/>

                <!-- Dark overlay to keep the splash title readable -->
                <Grid>
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1,0">

                            <GradientStop Color="#E8151515"
                                          Offset="0"/>

                            <GradientStop Color="#C9151515"
                                          Offset="0.45"/>

                            <GradientStop Color="#55151515"
                                          Offset="0.70"/>

                            <GradientStop Color="#00151515"
                                          Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                </Grid>

                <StackPanel Margin="42,28,390,24"
                            VerticalAlignment="Center">

                    <TextBlock Text="PARALLEL SYSTEMS"
                               Foreground="White"
                               FontSize="39"
                               FontWeight="Light"/>

                    <Rectangle Height="4"
                               Width="118"
                               Fill="{StaticResource Green}"
                               HorizontalAlignment="Left"
                               Margin="2,14,0,13"/>

                    <TextBlock Text="MODEL. FABRICATE. DELIVER."
                               Foreground="#F3F3F3"
                               FontSize="20"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>

            <!-- ========================================================= -->
            <!-- Main information section                                 -->
            <!-- ========================================================= -->
            <Grid Grid.Row="1"
                  Margin="34,18,34,16">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.1*"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Left-side plugin information -->
                <Grid Grid.Column="0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Parallel Systems Revit Plugin"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Dark}"/>

                    <TextBlock Grid.Row="1"
                               Margin="0,6,0,12"
                               TextWrapping="Wrap"
                               Foreground="#555555"
                               FontSize="14"
                               Text="Model-driven fabrication and project-delivery tools designed to improve consistency, traceability, quality assurance, and coordination from Revit modelling through fabrication and handover."/>

                    <!-- Plugin capability summaries -->
                    <Grid Grid.Row="2">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="FABRICATION WORKFLOWS"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource DarkGreen}"/>

                            <TextBlock Text="Automated reports, procurement data, fabrication status, detailing, and model checks."
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource Muted}"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">

                            <TextBlock Text="PROJECT TRACEABILITY"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource DarkGreen}"/>

                            <TextBlock Text="Structured project information and silent work-session tracking with offline protection."
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource Muted}"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Audit logging notice -->
                    <Border Grid.Row="3"
                            Margin="0,15,0,0"
                            Padding="12,10"
                            CornerRadius="5"
                            Background="{StaticResource LightGreen}"
                            BorderBrush="#C9DEC3"
                            BorderThickness="1">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Green status strip -->
                            <Border Grid.Column="0"
                                    Background="{StaticResource Green}"
                                    CornerRadius="2"/>

                            <StackPanel Grid.Column="2">

                                <TextBlock Text="AUDIT LOGGING ACTIVE"
                                           Foreground="{StaticResource DarkGreen}"
                                           FontSize="12.5"
                                           FontWeight="Bold"/>

                                <TextBlock Margin="0,3,0,0"
                                           Text="Relevant Revit work-session activity is recorded automatically for timesheet reporting, project monitoring, and operational auditing."
                                           Foreground="#4F5B4C"
                                           FontSize="11.5"
                                           LineHeight="16"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Right-side contact and version information -->
                <Border Grid.Column="2"
                        BorderBrush="#E2E2E2"
                        BorderThickness="1,0,0,0"
                        Padding="22,0,0,0">

                    <StackPanel>

                        <TextBlock Text="CONTACT US"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource DarkGreen}"/>

                        <TextBlock Text="Parallel Systems"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,12,0,4"/>

                        <TextBlock Text="parallelsystems.com.au"
                                   Foreground="#1A65B8"
                                   FontSize="14"/>

                        <TextBlock Text="Online contact and support"
                                   Foreground="{StaticResource Muted}"
                                   Margin="0,4,0,0"/>

                        <TextBlock Text="Australia"
                                   Foreground="{StaticResource Muted}"
                                   Margin="0,4,0,0"/>

                        <Border BorderBrush="#E7E7E7"
                                BorderThickness="0,1,0,0"
                                Margin="0,16,0,10"/>

                        <TextBlock Text="PLUGIN INFORMATION"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource DarkGreen}"/>

                        <TextBlock x:Name="VersionLabel"
                                   Text="Version 1.17.9"
                                   Margin="0,7,0,0"/>

                        <TextBlock Text="Internal / Unreleased"
                                   Foreground="{StaticResource Muted}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ========================================================= -->
            <!-- Loading footer                                            -->
            <!-- ========================================================= -->
            <Grid Grid.Row="2"
                  Background="#F2F2F2">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Margin="20,0"
                            VerticalAlignment="Center">

                    <ProgressBar x:Name="LoadingIndicator"
                                 Width="130"
                                 Height="5"
                                 IsIndeterminate="True"/>

                    <TextBlock x:Name="StatusLabel"
                               Text="Loading Parallel Systems tools..."
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               Foreground="#555555"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="© Parallel Systems"
                           VerticalAlignment="Center"
                           Margin="0,0,20,0"
                           Foreground="#777777"/>
            </Grid>
        </Grid>
    </Border>
</Window>
